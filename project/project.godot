[layer_names]

3d_physics/layer_1="player_hurt_box"
3d_physics/layer_2="enemy_hurt_box"
3d_physics/layer_3="walls"
3d_physics/layer_4="car"
3d_physics/layer_5="ground"
3d_physics/layer_6="player_body"
3d_physics/layer_7="enemy_body"
3d_physics/layer_8="interaction"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

specular_smoothness={
"type": "float",
"value": 0.0
}
fresnel_smoothness={
"type": "float",
"value": 0.0
}
outline_width={
"type": "float",
"value": 6.0
}
outline_color={
"type": "color",
"value": Color(0, 0.0117647, 0.0196078, 1)
}
