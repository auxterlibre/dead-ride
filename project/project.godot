; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dead Ride"
run/main_scene="uid://b56i3a2diovj6"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="uid://cbv3o8ntdqjak"

[audio]

buses/default_bus_layout="uid://epscqb8f5cxu"

[autoload]

Signals="*res://scripts/utils/signals.gd"
InputManager="*res://scripts/managers/input_manager.gd"
Globals="*res://scripts/utils/globals.gd"
Calendar="*res://scripts/managers/calendar.gd"
Settings="*res://scripts/managers/settings.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
LivePaletteRuntime="*uid://d31r5bjbh1oer"

[debug]

gdscript/warnings/unused_signal=0
shapes/navigation/3d/geometry_edge_color=Color(0.917647, 0.0235294, 0.160784, 1)
shapes/navigation/2d/geometry_edge_color=Color(0.917647, 0.0235294, 0.160784, 1)
shapes/collision/shape_color=Color(1, 0, 0.145098, 0.419608)

[display]

window/size/viewport_width=3840
window/size/viewport_height=2160
window/size/window_width_override=2560
window/size/window_height_override=1440
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=3

[editor_plugins]

enabled=PackedStringArray("res://addons/grid_map_painter/plugin.cfg", "res://addons/live_palette/plugin.cfg", "res://addons/scene_menu/plugin.cfg", "res://addons/storage_painter/plugin.cfg")

[file_customization]

folder_colors={
"res://_not_exported/": "gray",
"res://assets/": "pink",
"res://data/": "orange",
"res://scripts/": "green"
}

[global_group]

player=""

